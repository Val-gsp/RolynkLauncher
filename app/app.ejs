<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/home.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/interface.css">
    <style>
        body {
            -webkit-user-select: none;
        }
        /* Fond carbone de l'accueil, visible au chargement, entre deux écrans et sous la barre de titre. */
        body {
            background:
                radial-gradient(ellipse at 70% 0, #1b251b66, transparent 55%),
                radial-gradient(ellipse at 10% 100%, #1a2a1444, transparent 50%),
                repeating-linear-gradient(130deg, #ffffff02 0 1px, transparent 1px 5px),
                #101310;
        }
        #frameBar {
            background-color: #0b100b;
        }
        #main {
            display: none;
            height: calc(100% - 22px);
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
</head>
<body>
    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('rolynkAuth') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                <img id="loadCenterImage" src="assets/images/LoadingSeal.png">
                <img id="loadSpinnerImage" class="rotating" src="assets/images/LoadingText.png">
            </div>
        </div>
    </div>
</body>
</html>